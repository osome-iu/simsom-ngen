// SimSoM configuration.
// This config follows the current controller / worker / analytics / policy
// split and the Postgres-centered simulation design.

{
    // =====================================================================
    // DATABASE
    // Postgres owns persistence, lifecycle state, and simulator timestamps.
    // =====================================================================
    "database": {
        "dsn": "postgres",
        "schema": "simsom",
        "clock_extension": {
            "name": "simsom_clock"
        }
    },

    // =====================================================================
    // SYSTEM
    // Runtime/logging controls shared across processes.
    // =====================================================================
    "system": {
        "log": {
            "file": "simsom.log",
            "path": "output/logs"
        }
    },

    // =====================================================================
    // MESSAGE PASSING INTERFACE (MPI) LAYOUT
    // Role identifiers are code-owned; config controls rank placement only.
    // =====================================================================
    "mpi": {
        "num_procs": 8,
        "processes": {
            "controller": {
                "rank": 0
            },
            "analytics": {
                "rank": 1
            },
            "policy": {
                "rank": 2
            },
            "worker": {
                "start_rank": 3
            }
        }
    },

    // =====================================================================
    // CONTROLLER
    // Controller owns setup, teardown, dumps, and lifecycle coordination.
    // =====================================================================
    "controller": {
        "dump_on_termination": true,
        // Seconds for each shutdown wait: process termination and Analytics
        // readiness, then a fresh deadline for final Analytics completion.
        "final_analytics_timeout_seconds": 60.0
    },

    // =====================================================================
    // SETUP DATABASE
    // Setup/controller team owns planning the initial users and follower
    // network. The controller DB client persists the resulting dataset.
    // The simulator is designed for runs with up to 1,000,000,000 users.
    // PostgreSQL INTEGER user IDs technically allow up to 2,147,483,647.
    // =====================================================================
    "setup_db": {
        // "synthetic" runs configured edge-generation functions.
        // "file" imports directed user_id -> friend_id links from network_file.
        "network_source": "synthetic",
        // Used only when network_source is "file". Supported formats are
        // CSV, TSV, JSON, JSONL, and GML.
        "network_file": "./data/default_graph.gml",
        // User types are profile/behavior categories, not communities.
        //
        // Function names map to their explicit inputs. See
        // docs/algorithms/configuration.md for algorithms and calibration sources.
        //
        // As a default, we use quality to represent trustworthiness of news sources posted by users.
        // To calibrate the distribution of quality for posts, we consider posts with links to news sources rated by NewsGuard.
        // These ratings describe the accuracy and trustworthiness of news sources. NewsGuard ratings are defined in the range 0 to 100.
        // In the model we assume that the quality is defined in the unit interval, thus, these values are normalized between 0 and 1.
        // We use the ratings of posts to obtain the average quality of each user authoring those posts.
        // We use the empirical distribution of these quality values from a social media platform.
        // We then assume that each post by a user has quality close to the quality of the user.
        // We draw post quality from a Gaussian distribution centered at the user quality.
        // Researchers can replace the default distribution of quality with any arbitrary distribution of their choice.
        //
        // "user_quality_distribution.w" controls how user types map to the quality distribution;
        // value of 1.0 means the distribution is all high quality with a peak around 100,
        // value of 0.8 means the distribution has a small peak around 0 but is high skewed towards high quality
        //
        // The within-type random-walk selector uses the following network-degree setting:
        // start with a fully connected group of 3 users. Each later
        // user creates exactly avg_n_friend=3 links: one to a uniformly selected
        // earlier user, then two more links that try to follow that user's
        // outgoing links with probability_follow=0.5; unavailable links are
        // filled with uniformly selected earlier users.
        "user_types": {
            "normal": {
                "num_nodes": 10000,
                "lurker_ratio": 0.169, // Calibrated from Bluesky Firehose data.
                "edge_generation": {
                    "within_type_networking_function": {"random_walk": {"seed_size": 3, "avg_n_friend": 3, "probability_follow": 0.5}},
                    "cross_type_networking_function": {"power_law_by_followers_sparse": {"density": 0.0003, "power_law_exponent": 1.0}}
                },
                "activity_level_distribution": {
                    "power_law_activity": {"power_law_exponent": -1.58000482, "minimum_activity_level": 0.1, "maximum_activity_level": 10.0}
                },
                "user_quality_distribution": {
                    "w": 0.85,
                    "lambda_slope": 0.1190
                },
                // Post-level distribution inputs.
                "post_quality_distribution_function": {"gaussian_around_user_quality": {"stddev": 0.12}},
                "post_appeal_distribution_function": {"gaussian_around_user_quality": {"stddev": 0.12}},
                // Optional post-labeling functions. Each function adds one or
                // more labels under action.other_properties.post_labels.
                // A function that writes post_labels.survival_time also changes
                // policy timing: policy will hold that action out of every
                // rule_function until the stored simulator timestamp is due.
                "post_labeling_functions": {
                    "illegal_probability_n_survival_hours": {"probability": 0.01, "expected_survival_hours": 144}
                }
            },
            "bad": {
                "num_nodes": 0,
                "lurker_ratio": 0, // Not Calibrated
                "edge_generation": {
                    "within_type_networking_function": {"random_walk": {"seed_size": 3, "avg_n_friend": 3, "probability_follow": 0.5}},
                    "cross_type_networking_function": {"no_edges": {}}
                },
                "activity_level_distribution": {
                    // Calibration source: analyses/calibration/user/activity_level
                    "power_law_activity": {"power_law_exponent": -1.58000482, "minimum_activity_level": 1, "maximum_activity_level": 167}
                },
                "user_quality_distribution": {
                    "w": 0.15,
                    "lambda_slope": 0.1190
                },
                // Post-level distribution inputs.
                "post_quality_distribution_function": {"gaussian_around_user_quality": {"stddev": 0.12}},
                "post_appeal_distribution_function": {"gaussian_around_user_quality": {"stddev": 0.12}},
                // This list may be omitted when this user type has no labels.
                "post_labeling_functions": {}
            }
        }
    },

    // =====================================================================
    // WORKER
    // Worker orchestration controls. Workers fetch users, fetch feed
    // candidates, execute user behavior, and write actions.
    // =====================================================================
    "worker": {
        "batch_size": 30,
        // Wall-clock backoff only when no sessions are claimed; 0 retries
        // immediately. Tune against 0 to test whether fewer idle DB queries
        // reduce contention enough to improve throughput. No calibrated value.
        // See docs/algorithms/worker.md#idle-polling-and-performance.
        "idle_sleep_milliseconds": 0,
        "action_insert_chunk_size": 100
    },

    // =====================================================================
    // RECOMMENDATION SYSTEM (RECSYS)
    // Recommendation System team owns these knobs and the interpretation of
    // feed-building
    // strategy.
    // =====================================================================
    "recsys": {
        "feed_size": 15,
        // Inventory size = recsys.inventory_composition.size_multiplier * recsys.feedsize * worker.batch_size.
        // The multiplier sets the total inventory size.
        // In-network inventory size = Inventory size * (1 - recsys.inventory_composition.out_of_network_ratio).
        // Out-of-network inventory size = Inventory size * recsys.inventory_composition.out_of_network_ratio.
        // The ratio divides the total between in-network and out-of-network candidates.
        // These are requested sizes; actual inventories may be smaller if too few eligible candidates are available.
        "inventory_composition": {
            "out_of_network_ratio": 0.5,
            "size_multiplier": 3
        },
        // Engagement functions currently count global actions. Future
        // function names may add friends-scoped engagement components.
        "engagement_action_lookback_population_multiplier": 10,
        // Each component returns a score in [0, 1]. importance_in controls how
        // strongly that component affects in-network candidates in the combined ranking;
        // importance_out does the same for out-of-network candidates.
        "feed_weight_components": [
            {"appeal_component_function": {"post_appeal": {}}, "importance_in": 0.0, "importance_out": 0.0},
            {"recency_component_function": {"inverse_rank_recency": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"relevance_component_function": {"profile_vector_n_content_embedding_cosine_relevance": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_like_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_repost_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_reply_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_quote_count": {}}, "importance_in": 1.0, "importance_out": 1.0}
        ]
    },

    // =====================================================================
    // USER BEHAVIOR
    // User/domain team owns action generation and interpretation.
    // =====================================================================
    "user_behavior": {
        // Social media archive fits from the profile and post representation report.
        // Setup samples initial posts per user from this truncated power law.
        // Runtime session action counts follow actions_per_session_ratio.
        // Generalized gamma uses (a, c, loc, scale) and samples profile-post
        // cosine distances, rejecting values outside [0, 2].
        "content_embedding_generation_function": {
            "social_media_archive_content_embedding": {
                "gen_gamma": {"a": 0.559463, "c": 1.943292, "loc": 0.006263, "scale": 0.711543}
            }
        },
        // Must be between 0.0 and 1.0. Active users receive a fixed number of
        // actions calculated as round(feed_size * ratio) across the full
        // allowed ratio range. The rounded budget must be at least 1;
        // configurations that produce zero are rejected.
        "actions_per_session_ratio": 0.20,
        // Each component returns a score in [0, 1]. importance_in controls how
        // strongly that component affects in-network parent-action sampling;
        // importance_out does the same for out-of-network parent-action sampling.
        "feed_weight_components": [
            {"appeal_component_function": {"post_appeal": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"relevance_component_function": {"profile_vector_n_content_embedding_cosine_relevance": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_like_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_repost_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_reply_count": {}}, "importance_in": 1.0, "importance_out": 1.0},
            {"engagement_component_function": {"global_quote_count": {}}, "importance_in": 1.0, "importance_out": 1.0}
        ],
        "p_actions": {
            // Per-user action-share means/stds from event_distribution.ipynb.
            // Calibration source and cutoff: docs/algorithms/domain_activity.md.
            "like": [0.6915118327290447, 0.36454652573865576],
            "post": [0.15068090071198412, 0.3124205094831243],
            "repost": [0.0815232983022833, 0.18122663495827296],
            "reply": [0.065723841705132, 0.16981072168932315],
            "quote": [0.010560126551555762, 0.06587685283794088]
        },
        // Seven-parameter social media archive profile model:
        // PC1 uses a two-component Gaussian mixture; PC2-PC10 share a
        // zero-mean Gaussian. These 10 PCA dimensions explain 30.1883% of
        // variance in all-MiniLM-L6-v2 profile embeddings.
        "vector_profile_generation_function": {
            "pca_7param_social_media_archive_profile": {
                "dimension": 10,
                "pc1": {
                    "component1": {"mu": -0.268814, "sigma": 0.139779, "weight": 0.267976},
                    "component2": {"mu": 0.098406, "sigma": 0.130654, "weight": 0.732024}
                },
                "pc2_to_pc10": {"mu": 0.0, "sigma": 0.144802}
            }
        }
    },

    // =====================================================================
    // POLICY
    // Policy process configuration for moderation-action passes.
    // =====================================================================
    "policy": {
        "enabled": true,
        // Caps actions per pass and advisory locks per policy write,
        // reducing the risk of PostgreSQL running out of shared lock memory.
        "target_batch_size": 500,
        // Wall-clock backoff when a pass writes no interventions (including
        // empty passes); 0 retries immediately. Tune against 0 to measure
        // contention versus review latency; longer waits need not be faster.
        // See docs/algorithms/policy.md#polling-and-performance.
        "poll_interval_milliseconds": 0,
        // Policy rules are evaluated in this order for every fetched action target.
        // rule_functions decide intervention outcomes after target eligibility.
        // post_labels.survival_time, when present, is a policy-wide timing gate
        // and is not configured as a rule_function.
        "rule_functions": {
            "below_quality_threshold": {"threshold": 0.3},
            "illegal_content": {}
        }
    },

    // =====================================================================
    // ANALYTICS
    // Recurring analytics cadence and run-local structured output controls.
    // =====================================================================
    "analytics": {
        "evaluation_interval": {
            // Supported units: "average_actions_per_user" or "simulated_hours".
            // The positive value is the simulation progress between checks.
            "unit": "simulated_hours",
            // Evaluate once per simulated hour.
            "value": 1
        },
        // Every record includes action_count, avg_action_quality and
        // avg_actions_per_user. These groups add custom outputs; {} runs no
        // additional functions. Use {"function_name": {}} for a function
        // with no configurable inputs. See docs/algorithms/analytics.md#configurable-outputs.
        "recurring_functions": {},
        "final_functions": {},
        "analytics_output_file": "analytics_output.jsonl"
    },

    // =====================================================================
    // TERMINATION
    // Analytics publishes termination signals for configured criteria.
    // The controller records the authoritative lifecycle termination state.
    // =====================================================================
    "termination": {
        "termination_metrics_file": "termination_metrics.jsonl",
        "criteria_functions": {
            "max_avg_actions_per_user": {"threshold": 3.0},
            // new_ema = rho * previous_ema + (1-rho) * avg_action_quality.
            "exponential_moving_average_action_quality": {"threshold": 0.01, "rho": 0.8}
        },

    }
}
